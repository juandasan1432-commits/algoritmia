Algoritmo edadvalidar
	definir edad como entero
	//se pide la edad
	Escribir "edad"
	leer edad
	//si la edad es mayor o igual a 0 Y menor o igual 120 la edad es valida.
	//se deben de cumplir las dos condiciones
	si edad >= 0 y edad <=120 entonces
		escribir "edad valida"
	SiNo
		//si no cumple las condiciones la edad es invalida
		Escribir "edad invalidad"
	FinSi
	
FinAlgoritmo
